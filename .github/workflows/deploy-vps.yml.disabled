# ============================================================================
#  VPS deployment — podman (Quadlet) + nginx + `next start`
#
#  ⚠️  INACTIVE BY DESIGN.
#  GitHub Actions only runs workflow files ending in `.yml` / `.yaml`, so this
#  file ships as `deploy-vps.yml.disabled` and never triggers. To activate it
#  once the VPS is ready:
#    1. Install the Quadlet unit (deploy/pulsehavana-frontend.container) and
#       create the secrets/variables listed in `deploy/README.md`.
#    2. Rename this file to `deploy-vps.yml`.
#    3. Push (or run it from the Actions tab) — it deploys on pushes to `main`.
# ============================================================================

name: Deploy (VPS)

on:
  push:
    branches: [main]
  workflow_dispatch:

# Never cancel a deploy that is already running.
concurrency:
  group: deploy-vps
  cancel-in-progress: false

permissions:
  contents: read
  packages: write

env:
  IMAGE: ghcr.io/${{ github.repository }}

jobs:
  build-and-push:
    name: Build & push image
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Log in to the GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build & push (ghcr.io)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Containerfile
          push: true
          tags: |
            ${{ env.IMAGE }}:${{ github.sha }}
            ${{ env.IMAGE }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

  deploy:
    name: Deploy over SSH (Quadlet)
    runs-on: ubuntu-latest
    needs: build-and-push
    environment:
      name: production
      url: ${{ vars.PUBLIC_URL }}
    env:
      VPS_HOST: ${{ secrets.VPS_HOST }}
      VPS_USER: ${{ secrets.VPS_USER }}
      VPS_SSH_PORT: ${{ vars.VPS_SSH_PORT || '22' }}
    steps:
      - name: Configure SSH
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "${{ secrets.VPS_SSH_KEY }}" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          # Pin the host key (generate with `ssh-keyscan -H <host>`).
          printf '%s\n' "${{ secrets.VPS_SSH_KNOWN_HOSTS }}" >> ~/.ssh/known_hosts

      - name: Pull image and restart the Quadlet unit
        env:
          IMAGE_TAG: ghcr.io/${{ github.repository }}:${{ github.sha }}
        run: |
          ssh -p "$VPS_SSH_PORT" "$VPS_USER@$VPS_HOST" "bash -s -- '$IMAGE_TAG'" <<'EOF'
          set -euo pipefail
          IMG="$1"
          export XDG_RUNTIME_DIR="/run/user/$(id -u)"
          QUADLET_DIR="$HOME/.config/containers/systemd"
          DROPIN_DIR="$QUADLET_DIR/pulsehavana-frontend.container.d"

          podman pull "$IMG"
          mkdir -p "$DROPIN_DIR"
          printf '[Container]\nImage=%s\n' "$IMG" > "$DROPIN_DIR/10-image.conf"
          systemctl --user daemon-reload
          systemctl --user restart pulsehavana-frontend.service
          EOF

      - name: Health check
        run: |
          ssh -p "$VPS_SSH_PORT" "$VPS_USER@$VPS_HOST" 'bash -s' <<'EOF'
          set -euo pipefail
          export XDG_RUNTIME_DIR="/run/user/$(id -u)"
          for _ in $(seq 1 15); do
            curl -fsS -o /dev/null http://127.0.0.1:3000/ && exit 0
            sleep 2
          done
          echo 'Health check failed' >&2
          systemctl --user status pulsehavana-frontend.service --no-pager || true
          exit 1
          EOF
