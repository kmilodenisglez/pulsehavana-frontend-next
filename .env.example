# Pulse Havana Center Cell — frontend environment
#
# These variables are read at runtime on the server, so changing them does not
# require rebuilding the client bundle. Copy this file to `.env.local` for local
# development.

# Base URL of the Django API. The store configuration is read from
# `GET {API_BASE_URL}/config/`.
API_BASE_URL=http://localhost:8000/api/v1

# Fallbacks used only when the API does not provide a value (backend down or
# empty `StoreSettings`). Same names as the backend settings.
BUSINESS_WHATSAPP=+5359352209
STORE_NAME=Pulse Havana Center Cell
STORE_ADDRESS=Calle 23 esq. L, Vedado, La Habana
STORE_HOURS=Lun-Sáb 10:00-19:00
DEFAULT_CURRENCY=USD
